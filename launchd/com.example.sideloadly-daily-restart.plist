<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.sideloadly-daily-restart</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/path/to/sideloadly-monitor/restart.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/sideloadly-monitor</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/path/to/sideloadly-monitor/restart.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/sideloadly-monitor/restart.err.log</string>
</dict>
</plist>
